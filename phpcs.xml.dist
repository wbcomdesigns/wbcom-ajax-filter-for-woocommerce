<?xml version="1.0"?>
<ruleset name="Ajax Filter for WooCommerce">
	<description>
		Coding standard for this plugin.

		Committed so that "does this pass WPCS" has one answer rather than
		depending on whatever flags the person running it happened to type.
		Run it with no arguments:

		    phpcs

		Drift here is invisible until a WordPress.org review rejects the plugin,
		which is the worst possible moment to discover it.
	</description>

	<file>.</file>

	<!--
		Vendored and generated code is not ours to restyle. lib/wbcom-settings is
		shared across the portfolio and maintained in its own repo; reformatting
		it here would create a diff against every other plugin that vendors it.
		edd-license is the licensing SDK and is upstream code.
	-->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/lib/*</exclude-pattern>
	<exclude-pattern>/edd-license/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<exclude-pattern>*-rtl.css</exclude-pattern>

	<!--
		Generated by the block build. wp-scripts emits index.asset.php beside
		each built block and the enqueue reads that exact filename, so the
		"lowercase with hyphens" sniff cannot be satisfied without breaking the
		block. It is build output, not authored code.
	-->
	<exclude-pattern>*/blocks/*/index.asset.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!--
			WordPress passes the page hook to enqueue callbacks whether or not
			they use it. Removing the parameter changes a signature core calls;
			keeping it and being warned about it every run is noise.
		-->
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>

		<!--
			Yoda conditions are a style preference this codebase does not follow
			consistently, and mass-rewriting live conditionals to satisfy a
			sniff is a change with real risk and no user-visible benefit.
		-->
		<exclude name="Generic.ControlStructures.DisallowYodaConditions"/>
	</rule>

	<!--
		Text domain must match the one declared in the plugin header, or nothing
		is translatable. This is `wb-ajax-filter`, NOT the directory name - a
		ruleset copied from a sibling plugin and left with the sibling's domain
		produced 262 false mismatches on Price Quote Pro before it was caught.
	-->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wb-ajax-filter"/>
			</property>
		</properties>
	</rule>

	<!-- Everything public is prefixed, so a sibling plugin cannot collide. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wb_ajax_filter"/>
				<element value="WB_Ajax_Filter"/>
				<element value="WB_AJAX_FILTER"/>
			</property>
		</properties>
	</rule>

	<!--
		Template files receive their variables from whatever includes them, so
		every one of them reads as an unprefixed global to this sniff. WordPress
		core template files have exactly the same shape. The rest of the sniff
		still applies everywhere, including to these files.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/templates/*</exclude-pattern>
		<exclude-pattern>/admin/partials/*</exclude-pattern>
		<exclude-pattern>/public/partials/*</exclude-pattern>
		<exclude-pattern>/uninstall.php</exclude-pattern>
	</rule>

	<!--
		Capabilities this plugin checks that are not WordPress core's. The sniff
		cannot know they are valid; naming them here is the assertion that they
		are deliberate rather than typos.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!--
		The minimum this plugin claims to support in its header.

		PHPCompatibilityWP is deliberately NOT referenced here: it is not
		installed in every environment this runs in, and a ruleset that errors
		out on a missing sniff blocks the whole check rather than skipping one
		rule.
	-->
	<config name="minimum_wp_version" value="4.0"/>
</ruleset>
